@page "{lotId:int}"
@model QcTrace.Web.Pages.Inspections.InputModel
@{
    ViewData["Title"] = "검사 입력";
    var q = Model.Lot.Quantity!;
}

<h1 class="h3">검사 입력 <small><partial name="_LotLink" model="Model.Lot.LotNo" /></small></h1>
<p class="mb-1">@Model.Lot.Item.ItemCode @Model.Lot.Item.Name · 생산 @Model.Lot.ProducedQty EA</p>
<p class="small"><partial name="_QtyBadges" model="q" /></p>
<partial name="_StatusMessage" model="Model.StatusMessage" />

@if (Model.Lot.Status == "Registered")
{
    <div class="alert alert-warning">검사 의뢰 전 LOT입니다. 생산 담당이 검사를 의뢰해야 입력할 수 있습니다.</div>
}

<form method="post" id="inspection-form">
    <input type="hidden" asp-for="RequestKey" />
    <table class="table table-sm w-auto">
        <thead><tr><th>검사 항목</th><th>규격</th><th>측정값</th><th>판정</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td class="small">@item.Lower.ToString("0.###") ~ @item.Upper.ToString("0.###") @item.Unit</td>
                <td>
                    <input name="Measured[@item.Id]" value="@Model.Measured.GetValueOrDefault(item.Id)" class="form-control form-control-sm measured"
                           inputmode="decimal" data-lower="@item.Lower.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           data-upper="@item.Upper.ToString(System.Globalization.CultureInfo.InvariantCulture)" style="width:8rem" />
                </td>
                <td class="item-verdict small"></td>
            </tr>
        }
        </tbody>
    </table>

    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label asp-for="Qty" class="form-label">이번 검사 수량</label>
            <input asp-for="Qty" type="number" min="1" class="form-control" style="width:8rem" />
            <div class="form-text">남은 미검사 @(q.Uninspected)개. 넘기면 초과분은 보류로 기록됩니다(R9).</div>
        </div>
        <div class="col-auto">
            <label class="form-label">판정</label>
            <div>
                @foreach (var v in new[] { "Pass", "Fail", "Hold" })
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input verdict" type="radio" asp-for="Verdict" value="@v" id="verdict-@v" />
                        <label class="form-check-label" for="verdict-@v">@QcTrace.Web.Pages.Inspections.InputModel.VerdictLabel(v)</label>
                    </div>
                }
            </div>
            <div class="form-text" id="auto-verdict"></div>
        </div>
        <div class="col-md-3" id="defect-box">
            <label for="DefectCodeId" class="form-label">불량 유형 <span id="defect-required" class="text-danger d-none">(필수)</span></label>
            <select id="DefectCodeId" name="DefectCodeId" class="form-select">
                <option value="">선택</option>
                @foreach (var d in Model.DefectCodes)
                {
                    <option value="@d.Id" data-code="@d.Code" selected="@(Model.DefectCodeId == d.Id)">@d.Name</option>
                }
            </select>
            <div class="form-text">목록에 없으면 "기타"를 고르고 사유를 직접 씁니다.</div>
        </div>
        <div class="col-md-4">
            <label asp-for="Reason" class="form-label"><span id="reason-label">상세 사유</span> <span id="reason-required" class="text-danger d-none">(필수)</span></label>
            <input asp-for="Reason" class="form-control" maxlength="500" placeholder="예: 외경 141.3mm, 2번 금형" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">검사 반영</button>
            <a class="btn btn-link" asp-page="./Index">목록</a>
        </div>
    </div>
</form>

@section Scripts { <script src="~/js/inspection.js" asp-append-version="true"></script> }
