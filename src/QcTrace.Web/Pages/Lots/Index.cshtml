@page
@model QcTrace.Web.Pages.Lots.IndexModel
@using QcTrace.Web.Services
@{
    ViewData["Title"] = "LOT 목록·등록";
    var filters = new (string? Value, string Label)[] { (null, "전체"), ("Registered", "등록"), ("Waiting", "검사 대기"), ("Inspecting", "부분 검사"), ("Inspected", "검사 완료"), ("Shipped", "출하 완료") };
}

<h1 class="h3">LOT 목록·등록</h1>
<partial name="_StatusMessage" model="Model.StatusMessage" />

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">생산 LOT 등록</h2>
        <form method="post" asp-page-handler="Register" class="row g-2 align-items-end">
            <input type="hidden" asp-for="Input.RequestKey" />
            <div class="col-md-4">
                <label asp-for="Input.ItemId" class="form-label">품목</label>
                <select asp-for="Input.ItemId" asp-items="Model.ItemOptions" class="form-select">
                    <option value="">선택</option>
                </select>
                <span asp-validation-for="Input.ItemId" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Input.ProducedQty" class="form-label">생산 수량 (EA)</label>
                <input asp-for="Input.ProducedQty" type="number" min="1" class="form-control" />
                <span asp-validation-for="Input.ProducedQty" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Input.ProducedOn" class="form-label">생산일</label>
                <input asp-for="Input.ProducedOn" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Input.Shift" class="form-label">작업반</label>
                <select asp-for="Input.Shift" class="form-select">
                    @foreach (var s in QcTrace.Web.Pages.Lots.IndexModel.Shifts) { <option value="@s">@s</option> }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">등록</button>
            </div>
        </form>
    </div>
</div>

<div class="mb-2">
    @foreach (var (value, label) in filters)
    {
        <a class="btn btn-sm @(Model.Status == value ? "btn-dark" : "btn-outline-secondary")" asp-page="./Index" asp-route-status="@value">@label</a>
    }
</div>

<table class="table table-sm">
    <thead><tr><th>LOT</th><th>품목</th><th>생산</th><th>상태</th><th>수량</th><th></th></tr></thead>
    <tbody>
    @foreach (var lot in Model.Lots)
    {
        <tr>
            <td>@lot.LotNo<div class="text-muted small">@lot.ProducedOn.ToString("yyyy-MM-dd") · @lot.Shift</div></td>
            <td>@lot.Item.ItemCode<div class="text-muted small">@lot.Item.Name</div></td>
            <td>@lot.ProducedQty</td>
            <td><partial name="_LotStatus" model="lot.Status" /></td>
            <td class="small"><partial name="_QtyBadges" model="lot.Quantity" /></td>
            <td>
                @if (lot.Status == "Registered")
                {
                    <form method="post" asp-page-handler="RequestInspection" asp-route-status="@Model.Status">
                        <input type="hidden" name="lotId" value="@lot.Id" />
                        <input type="hidden" name="requestKey" value="@QcTrace.Web.Pages.QcPageModel.NewRequestKey()" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">검사 의뢰</button>
                    </form>
                }
                else if (lot.InspectionRequestedAt is not null)
                {
                    <span class="text-muted small">의뢰 @Kst.Format(lot.InspectionRequestedAt)</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
