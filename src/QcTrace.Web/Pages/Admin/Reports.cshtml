@page "{handler?}"
@model QcTrace.Web.Pages.Admin.ReportsModel
@using QcTrace.Web.Services
@{
    ViewData["Title"] = "보고서·알림";
}

<h1 class="h3">보고서·알림</h1>
<partial name="_StatusMessage" model="Model.StatusMessage" />

<h2 class="h5 mt-3">검사 지연 알림 <span class="badge bg-danger" id="open-alert-count">@Model.OpenAlerts.Count</span></h2>
<p class="text-muted small">검사 의뢰 후 @((int)QcQueries.DelayThreshold.TotalHours)시간이 지나도 미검사가 남은 LOT입니다. 1분마다 확인해 처음 발견한 시각을 기록합니다(기록은 지우거나 고칠 수 없음).</p>
@if (Model.OpenAlerts.Count == 0)
{
    <p class="text-success" id="no-open-alerts">지금 지연된 LOT이 없습니다.</p>
}
else
{
    <table class="table table-sm align-middle" id="open-alerts">
        <thead><tr><th>LOT</th><th>품목</th><th>검사 의뢰</th><th class="text-end">경과</th><th class="text-end">미검사</th><th>알림 기록</th></tr></thead>
        <tbody>
        @foreach (var a in Model.OpenAlerts)
        {
            <tr class="table-danger">
                <td><a asp-page="/Admin/Ledger" asp-route-LotNo="@a.LotNo">@a.LotNo</a></td>
                <td>@a.ItemCode</td>
                <td>@Kst.Format(a.RequestedAt)</td>
                <td class="text-end">@(a.Hours)시간</td>
                <td class="text-end">@a.Uninspected</td>
                <td>@Kst.Format(a.DetectedAt)</td>
            </tr>
        }
        </tbody>
    </table>
}
@if (Model.ClosedAlerts.Count > 0)
{
    <details class="mb-3">
        <summary class="small">해소된 알림 @(Model.ClosedAlerts.Count)건 (최근 50건)</summary>
        <table class="table table-sm small mt-2" id="closed-alerts">
            <thead><tr><th>LOT</th><th>품목</th><th>검사 의뢰</th><th>알림 기록</th><th class="text-end">발견 당시 미검사</th><th>현재 상태</th></tr></thead>
            <tbody>
            @foreach (var a in Model.ClosedAlerts)
            {
                <tr>
                    <td><a asp-page="/Admin/Ledger" asp-route-LotNo="@a.LotNo">@a.LotNo</a></td>
                    <td>@a.ItemCode</td>
                    <td>@Kst.Format(a.RequestedAt)</td>
                    <td>@Kst.Format(a.DetectedAt)</td>
                    <td class="text-end">@a.UninspectedAtDetection</td>
                    <td>@a.Status</td>
                </tr>
            }
            </tbody>
        </table>
    </details>
}

<h2 class="h5 mt-4">일일 보고서</h2>
<p class="text-muted small">매일 한국 시간 @Model.RunAt.ToString("HH:mm")에 전날 검사·출하 실적을 엑셀로 만듭니다. 그 시각에 앱이 꺼져 있었으면 다음에 켜질 때 만듭니다.</p>
<form method="post" asp-page-handler="Generate" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="BusinessDate">보고 기준일</label>
        <input type="date" class="form-control form-control-sm" asp-for="BusinessDate" value="@Model.DefaultDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto"><button class="btn btn-sm btn-outline-primary" id="generate">지금 만들기(같은 날짜는 덮어씀)</button></div>
</form>
@if (Model.Files.Count == 0)
{
    <p class="text-muted" id="no-reports">아직 보고서가 없습니다.</p>
}
else
{
    <table class="table table-sm" id="reports">
        <thead><tr><th>기준일</th><th>파일</th><th class="text-end">크기</th><th>만든 시각</th></tr></thead>
        <tbody>
        @foreach (var f in Model.Files)
        {
            <tr>
                <td>@f.BusinessDate.ToString("yyyy-MM-dd")</td>
                <td><a asp-page-handler="Download" asp-route-name="@f.Name">@f.Name</a></td>
                <td class="text-end">@((f.Size / 1024.0).ToString("0.0")) KB</td>
                <td>@Kst.FormatSeconds(f.WrittenAtUtc)</td>
            </tr>
        }
        </tbody>
    </table>
}
