@page
@* 운영 대시보드. 서버는 빈 틀만 내려주고, 내용은 wwwroot/js/dashboard.js가 /api/dashboard를 fetch해서 그린다(프레임워크 없음). *@
@{
    ViewData["Title"] = "운영 대시보드";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h3 mb-0">운영 대시보드</h1>
    <div class="small text-muted">
        <span id="dash-updated" aria-live="polite">불러오는 중…</span>
        <button type="button" id="dash-refresh" class="btn btn-sm btn-outline-secondary ms-2">새로고침</button>
    </div>
</div>
<div id="dash-error" class="alert alert-danger d-none" role="alert"></div>

<div class="row g-2 mb-3" id="dash-kpis">
    <div class="col-6 col-lg-3"><a class="card kpi text-decoration-none" href="#dash-actions">
        <div class="card-body py-2"><div class="small text-muted">검사 대기</div>
            <div class="fs-3" data-kpi="waiting">–</div><div class="small text-muted" data-kpi="waiting-qty"></div></div></a></div>
    <div class="col-6 col-lg-3"><a class="card kpi text-decoration-none" href="#dash-delayed">
        <div class="card-body py-2"><div class="small text-muted">검사 지연 LOT (<span data-kpi="threshold">48</span>시간 초과)</div>
            <div class="fs-3" data-kpi="delayed">–</div><div class="small text-muted">의뢰 후 미검사 남음</div></div></a></div>
    <div class="col-6 col-lg-3"><div class="card kpi">
        <div class="card-body py-2"><div class="small text-muted">불합격률 (오늘 · 최근 7일)</div>
            <div class="fs-3" data-kpi="fail-today">–</div><div class="small text-muted" data-kpi="fail-7d"></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card kpi">
        <div class="card-body py-2"><div class="small text-muted">당일 출하</div>
            <div class="fs-3" data-kpi="shipped">–</div><div class="small text-muted" data-kpi="shipped-count"></div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-2" id="dash-actions">조치 목록 <span class="badge bg-secondary" data-kpi="action-total">0</span></h2>
            <div class="btn-group btn-group-sm mb-2" role="group" aria-label="조치 필터" id="dash-filters">
                <button type="button" class="btn btn-outline-secondary active" data-filter="">전체</button>
                <button type="button" class="btn btn-outline-danger" data-filter="danger">긴급</button>
                <button type="button" class="btn btn-outline-warning" data-filter="warning">검사</button>
                <button type="button" class="btn btn-outline-info" data-filter="info">승인·출하</button>
            </div>
        </div>
        <div class="list-group" id="dash-action-list"></div>
        <p class="small text-muted mt-2" id="dash-action-note"></p>
    </div>
    <div class="col-lg-5">
        <h2 class="h5" id="dash-delayed">검사 지연 LOT</h2>
        <table class="table table-sm">
            <thead><tr><th>LOT</th><th>품목</th><th class="text-end">경과</th><th class="text-end">미검사</th></tr></thead>
            <tbody id="dash-delayed-rows"></tbody>
        </table>
        <h2 class="h5 mt-3">최근 7일 검사·출하</h2>
        <table class="table table-sm">
            <thead><tr><th>날짜</th><th class="text-end">검사</th><th class="text-end">불합격</th><th class="text-end">불합격률</th><th class="text-end">출하</th></tr></thead>
            <tbody id="dash-daily-rows"></tbody>
        </table>
    </div>
</div>

@section Scripts { <script src="~/js/dashboard.js" asp-append-version="true"></script> }
