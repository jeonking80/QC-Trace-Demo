<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QC Trace</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QcTrace.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">QC Trace</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* 메뉴는 역할에 맞는 것만 보인다. 실제 접근 제한은 서버 정책(Auth/Policies.cs)이 한다. *@
                        @foreach (var (path, label, role) in Menu)
                        {
                            if (role == "*" ? QcTrace.Web.Data.Seed.Roles.All.Any(User.IsInRole) : User.IsInRole(role))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" href="@path">@label</a></li>
                            }
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page="/Account/Logout" class="d-flex align-items-center gap-2">
                            <span class="navbar-text small">@User.Identity.Name</span>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">로그아웃</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 QC Trace · 가상 데이터 기반 데모
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private static readonly (string Path, string Label, string Role)[] Menu =
    [
        ("/Admin/Dashboard", "대시보드", QcTrace.Web.Data.Seed.Roles.Admin),
        ("/Admin/Ledger", "이력 원장", QcTrace.Web.Data.Seed.Roles.Admin),
        ("/Admin/Reconcile", "재고 대사", QcTrace.Web.Data.Seed.Roles.Admin),
        ("/Admin/Items", "기준정보", QcTrace.Web.Data.Seed.Roles.Admin),
        ("/Admin/Reports", "보고서·알림", QcTrace.Web.Data.Seed.Roles.Admin),
        ("/Admin/Users", "사용자", QcTrace.Web.Data.Seed.Roles.Admin),
        ("/Lots", "LOT", QcTrace.Web.Data.Seed.Roles.Producer),
        ("/Inspections", "검사", QcTrace.Web.Data.Seed.Roles.Inspector),
        ("/Approvals", "출하 승인", QcTrace.Web.Data.Seed.Roles.Approver),
        ("/Shipments", "출하", QcTrace.Web.Data.Seed.Roles.Shipper),
        ("/Trace", "LOT 조회", "*"),
    ];
}
