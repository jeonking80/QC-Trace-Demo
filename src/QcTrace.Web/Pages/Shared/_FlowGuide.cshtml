@model string
@*
  업무 흐름 안내(집 PC 피드백 B4). 모델: 지금 화면의 단계 키(produce, inspect, approve, ship, all).
  역할마다 할 일이 나뉘어 있어 처음 쓰는 사람이 전체 흐름과 자기 차례를 알 수 있게 한다.
*@
@{
    var steps = new (string Key, string Role, string Title)[]
    {
        ("produce", "생산 담당", "LOT 등록 · 검사 의뢰"),
        ("inspect", "검사자", "검사 · 불합격 처리"),
        ("approve", "승인권자", "출하 승인"),
        ("ship", "출하 담당", "출하"),
    };
    var (todo, next) = Model switch
    {
        "produce" => ("생산한 LOT을 등록하고 [검사 의뢰]를 누르세요. 의뢰해야 검사자 화면에 나타납니다.",
                      "검사자가 검사합니다. 불합격·보류 사유와 진행 상황은 LOT 번호를 눌러 볼 수 있습니다."),
        "inspect" => ("[검사 입력]에서 측정값을 넣고 판정합니다(합격은 전 항목 규격 안). 불합격은 [불합격 처리]에서 재검사 또는 폐기로 정리합니다(사유 필수).",
                      "합격분은 승인권자가 출하를 승인합니다. 내가 검사한 LOT은 내가 승인할 수 없습니다."),
        "approve" => ("합격 수량 중 출하할 만큼 승인합니다. 직접 검사한 LOT은 승인 버튼이 막힙니다(독립 승인).",
                      "출하 담당이 승인된 수량 안에서 출하합니다."),
        "ship" => ("승인된 잔량 안에서 출하처와 수량을 넣어 출하합니다. 승인 수량을 넘으면 거절됩니다.",
                   "모든 기록은 원장에 남고, 관리자가 대시보드·재고 대사로 확인합니다."),
        _ => ("왼쪽부터 순서대로 진행됩니다. 위 메뉴에는 내 역할의 화면만 보입니다.",
              "어느 LOT이든 [LOT 조회]에서 번호를 누르면 지금 상태와 다음 할 일을 볼 수 있습니다."),
    };
}
<div class="card mb-3 flow-guide" id="flow-guide">
    <div class="card-body py-2">
        <ol class="flow-steps list-unstyled d-flex flex-wrap gap-1 mb-2 small">
            @for (var i = 0; i < steps.Length; i++)
            {
                var s = steps[i];
                <li class="badge @(s.Key == Model ? "bg-primary" : "bg-light text-dark border")">@(i + 1). @s.Title <span class="fw-normal">(@s.Role)</span></li>
                @if (i < steps.Length - 1) { <li class="text-muted">→</li> }
            }
        </ol>
        <div class="small"><strong>이 화면에서 할 일</strong> · @todo</div>
        <div class="small text-muted"><strong>다음</strong> · @next</div>
    </div>
</div>
